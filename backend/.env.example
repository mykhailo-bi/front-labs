# Django
DJANGO_DEBUG=1
DJANGO_SECRET_KEY=PLEASE_CHANGE_ME__GENERATE_A_RANDOM_VALUE
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# JWT (optional; defaults to DJANGO_SECRET_KEY)
JWT_SECRET_KEY=
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_SECONDS=1209600

# API (optional)
API_PAGE_SIZE=20

# Throttling (optional)
API_THROTTLE_ANON=60/min
API_THROTTLE_USER=600/min

# Media (optional)
# MEDIA_ROOT can be absolute (e.g. /var/lib/app/media) or relative to the backend directory.
MEDIA_ROOT=media
MEDIA_URL=/media/

# Database (PostgreSQL)
DB_ENGINE=django.db.backends.postgresql
DB_NAME=front_labs
DB_USER=user
DB_PASSWORD=PLEASE_CHANGE_ME
DB_HOST=127.0.0.1
DB_PORT=5432
